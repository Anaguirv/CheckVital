---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CtaWhatsApp from "../../components/CtaWhatsApp.astro";

export async function getStaticPaths() {
  const services = await getCollection("services");

  return services.map((service) => ({
    params: { id: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const { data, slug } = service;
const { title, precio, img, duration, description, sesiones, keywords } = data;

const { Content } = await render(service);

// og:image dedicada si existe (jpg/png); si no, Layout usa la tarjeta de marca
const ogImageMap: Record<string, string> = {
  'adn-salmon': '/og-adn-salmon.jpg',
};
const ogImage = ogImageMap[slug];

const pageKeywords = keywords?.join(', ') || `${title}, tratamiento estético La Serena, clínica estética La Serena, CheckVital`;

// Service schema: entrega a Google y a los buscadores con IA el precio, el proveedor
// y la zona de cobertura de forma legible por máquina
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": title,
  "description": description,
  "url": `https://checkvital.cl/servicios/${slug}`,
  "image": `https://checkvital.cl/${img}`,
  "serviceType": data.category,
  "category": data.category,
  "provider": {
    "@type": "BeautySalon",
    "name": "CheckVital - Salud Estética y Belleza La Serena",
    "url": "https://checkvital.cl",
    "telephone": "+56989827644",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Calle Central 95, Parcela 36, Alfalfares",
      "addressLocality": "La Serena",
      "addressRegion": "Región de Coquimbo",
      "addressCountry": "CL"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "La Serena" },
    { "@type": "City", "name": "Coquimbo" },
    { "@type": "AdministrativeArea", "name": "Región de Coquimbo" }
  ],
  "offers": {
    "@type": "Offer",
    "url": `https://checkvital.cl/servicios/${slug}`,
    "availability": "https://schema.org/InStock",
    "priceCurrency": "CLP",
    ...(precio && precio > 0
      ? { "price": precio }
      : { "priceSpecification": { "@type": "PriceSpecification", "priceCurrency": "CLP", "description": "Valor definido en evaluación gratuita" } })
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://checkvital.cl" },
    { "@type": "ListItem", "position": 2, "name": "Tratamientos", "item": "https://checkvital.cl/#tratamientos" },
    { "@type": "ListItem", "position": 3, "name": title, "item": `https://checkvital.cl/servicios/${slug}` }
  ]
};
---

<Layout
  title={title}
  description={description}
  keywords={pageKeywords}
  image={ogImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <section class="max-w-5xl mx-auto px-4 py-12 grid md:grid-cols-2 gap-10 items-start">
    
    <!-- Columna izquierda: Botón y imagen -->
    <div class="space-y-6">

      <img 
        src={`/${img}`} 
        alt={title} 
        class="rounded-2xl shadow-lg w-full object-cover h-auto max-h-[500px]"
        transition:name={`img-${slug}`}
      />
            <a 
        href="/" 
        onclick={`navigateTo(event, 'tratamientos')`} 
        class="inline-block text-m text-primary hover:underline font-medium"
      >
        ← Volver a la lista de tratamientos
      </a>
    </div>

    <!-- Columna derecha: Información -->
    <div>
      <h1 class="text-4xl font-bold text-primary mb-4 text-center md:text-left">
        {title}
      </h1>

      <p class="text-gray-700 mb-4">{description}</p>
      <p class="text-gray-600 mb-2 text-lg">
        <strong>Duración:</strong> {duration} minutos
      </p>
      {precio && precio > 0 ? (
        <p class="text-gray-600 mb-2 text-lg">
          <strong>Precio:</strong> ${precio.toLocaleString("es-CL")}
        </p>
      ) : (
        <p class="text-gray-600 mb-2 text-lg">
          <strong>Precio:</strong> <span class="text-primary font-medium">Consultar — agenda tu evaluación gratuita</span>
        </p>
      )}
      {typeof sesiones !== "undefined" && (
        <p class="text-gray-600 mb-2 text-lg">
          <strong>Sesiones:</strong> {sesiones}
        </p>
      )}

      <!-- CTA -->
      <div class="flex mt-8 justify-center md:justify-start">
        <CtaWhatsApp servicio={title} />
      </div>
    </div>
  </section>

  <section class="prose lg:prose-lg max-w-4xl mx-auto px-4 py-8">
    <Content />
  </section>
</Layout>

