---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const title = "Blog | CheckVital La Serena — Consejos y Novedades en Estética";
const description = "Blog de CheckVital La Serena: consejos de cuidado de piel, novedades en tratamientos estéticos, guías y todo lo que necesitas saber antes de tu próxima sesión.";
---

<Layout title={title} description={description}>
  <section class="max-w-5xl mx-auto px-4 py-14">
    <h1 class="text-4xl font-bold text-primary mb-2 text-center">Blog CheckVital</h1>
    <p class="text-gray-500 text-center mb-10">Consejos de piel, novedades en tratamientos y guías prácticas</p>

    <div class="grid md:grid-cols-2 gap-8">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="group block rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
          <img
            src={`/${post.data.img}`}
            alt={post.data.title}
            class="w-full h-52 object-cover group-hover:scale-[1.02] transition-transform duration-300"
          />
          <div class="p-5">
            <p class="text-xs text-gray-400 mb-2">
              {new Date(post.data.date).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}
              {post.data.author && <span class="ml-2">· {post.data.author}</span>}
            </p>
            <h2 class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors leading-snug mb-2">
              {post.data.title}
            </h2>
            <p class="text-gray-500 text-sm line-clamp-3">{post.data.description}</p>
            <span class="inline-block mt-4 text-primary text-sm font-medium group-hover:underline">Leer artículo →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
