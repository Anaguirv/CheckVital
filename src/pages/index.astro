---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AboutMe from '../components/AboutMe.astro';
import Mapa from '../components/Mapa.astro';
import GoogleReview from '../components/GoogleReview.astro';
import BtnFloating from '../components/BtnFloating.astro';
import AnimatedCounter from '../components/AnimatedCounter.astro';
import ScrollingBanner from '../components/ScrollingBanner.astro';
import Treatments from '../components/Treatments.astro';
import Herotext from '../components/HeroText.astro';
import TreatmentsStar from '../components/TreatmentsStar.astro';
import { getCollection } from "astro:content";

const title = "CheckVital La Serena | Limpieza Facial, Peeling, Botox y Más | Respaldo Clínico";
const description = "CheckVital La Serena — Procedimientos estéticos con respaldo clínico. Limpieza facial, peeling, botox, bioestimulador, ácido hialurónico y más. Realizado por Evelyn Briceño con 10 años de experiencia clínica. Evaluación gratuita.";
const keywords = "tratamientos estéticos la serena, clínica estética la serena, pink glow la serena, amber glow la serena, botox la serena, hilos tensores la serena, mesoterapia la serena, peeling la serena, peeling químico la serena, peeling de algas la serena, alta frecuencia la serena, bioestimulador la serena, limpieza facial profunda la serena, ácido hialurónico la serena, rejuvenecimiento facial la serena, estética facial la serena, estética corporal la serena, checkvital la serena";

const services = await getCollection("services");
---

<Layout 
    title={title}
    description={description}
    keywords={keywords}>
    
    <Hero />
    <Herotext />
    <AnimatedCounter  />
    <ScrollingBanner />
    <TreatmentsStar />
    <Treatments services={services} />
    <GoogleReview />
    <AboutMe />
    <Mapa />
    <BtnFloating />

</Layout>

<!-- SEO visible: texto optimizado con palabras clave y tratamientos -->
<section class="max-w-4xl mx-auto px-4 py-8 text-center text-gray-700">
  <p>
    En <strong>CheckVital Clínica Estética La Serena</strong> ofrecemos tratamientos estéticos como limpieza facial profunda, Pink Glow, Amber Glow, Botox, Hilos Tensores, Mesoterapia, Peeling de Algas, Peeling Químico, Alta Frecuencia, Bioestimulador y Ácido Hialurónico. Todos nuestros tratamientos son realizados por Evelyn Briceño, enfermera titulada con más de 10 años de experiencia clínica en La Serena. Nuestros peelings incluyen limpieza facial profunda como parte integral del procedimiento.
  </p>
  <p class="mt-4">
    ¿Buscas limpieza facial, tratamiento para manchas, acné, poros dilatados, flacidez o rejuvenecimiento facial sin cirugía en La Serena? Agenda tu evaluación gratuita en CheckVital. Consulta también nuestra <a href="/verano-la-serena" class="text-primary hover:underline">guía de tratamientos para el verano en La Serena</a>.
  </p>
</section>
